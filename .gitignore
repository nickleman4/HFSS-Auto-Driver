# ==========================================
# Ansys HFSS 仿真生成文件 (核心拦截项)
# ==========================================
# 忽略庞大的仿真结果文件夹
*.aedtresults/
*.hfssresults/

# 忽略 HFSS 进程锁文件 (防止误传导致其他人拉取后无法打开模型)
*.lock
*.auto

# 忽略 HFSS 运行日志
*.log
batch.log

# ==========================================
# Python 缓存与虚拟环境
# ==========================================
# 忽略 Python 编译的字节码缓存
__pycache__/
*.py[cod]
*$py.class

# 忽略虚拟环境文件夹 (环境应通过 requirements.txt 重建，绝不能上传)
.venv/
venv/
env/
.env

# ==========================================
# IDE 与操作系统级文件
# ==========================================
# VSCode / PyCharm 配置文件
.vscode/
.idea/

# Windows / macOS 系统缓存文件
Thumbs.db
.DS_Store

# ==========================================
# 本地运行生成的输出数据
# ==========================================
# 仿真输出结果目录
result/

# 运行时生成的元数据
run_metadata.yaml

# 旧版结果文件
result_data.csv

# ==========================================
# Claude Code 本地配置
# ==========================================
.claude/

# ==========================================
# 个人文件
# ==========================================
文件目录备忘.txt